// Authentication
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_SECRET= 
NEXTAUTH_URL=

//Admin dashboard credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=

// Database (Neon and Cloudinary)
DATABASE_URL=
CLOUDINARY_URL=

// Mailing 
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=
NEXT_PUBLIC_SITE_NAME=

// Web Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

// Analytics (Github and GA) 
NEXT_PUBLIC_GA_ID=
GITHUB_TOKEN=

// AI ChatBot (Gemini and llama)
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

AI_CHAT_PROVIDER=
AI_CHAT_MODEL=

// Automated blog pipeline (scripts/generate-blog.mjs + .github/workflows/auto-blog.yml)
// Uncomment to load the full agent skill files (agents/skills/*/SKILL.md) at runtime instead of
// the compact distilled directives — only for providers/tiers with generous token budgets.
// BLOG_FULL_SKILL_REFS=false
// Uncomment to override the default max prompt size (~6000 tokens) allowed before generation.
// The pipeline fails fast if the assembled prompt exceeds this budget.
// BLOG_PROMPT_BUDGET=6000
ENABLE_BLOG_AUTOMATION=
// Generate with: openssl rand -hex 32
// Set the SAME value here (Vercel) and as a GitHub Actions secret.
BLOG_AUTOMATION_TOKEN=

// Security
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IPINFO_API=

// AI Rate Limit and Security Variables
AI_SECURITY=
AI_LIMIT=